# ===== LLM (pi) =====
# pi uses its own auth system: env API keys or `pi /login` (~/.pi/agent/auth.json).
# Any provider supported by pi works (Anthropic, OpenAI, DeepSeek, Gemini, ...).
# Examples:
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# DEEPSEEK_API_KEY=sk-...
#
# Model selection (optional). If unset, pi picks a sensible default.
# This task benefits from thinking; do NOT set PI_THINKING=off unless you
# want forced tool_choice mode (off => tool_choice is forced per function).
# PI_TEXT_MODEL=deepseek/deepseek-v4-flash
# PI_VISION_MODEL=anthropic/claude-sonnet-4-5
# PI_THINKING=off|minimal|low|medium|high
# LLM_MAX_TURNS=3

# DeepSeek vision model (deepseek-v4-flash-vision-exp) via OpenAI-compatible custom endpoint.
# The vision model is not in pi's built-in catalog, so it needs the block below.
# DEEPSEEK_API_KEY=sk-...
# PI_TEXT_MODEL=deepseek/deepseek-v4-flash
# PI_VISION_MODEL=deepseek-vision/deepseek-v4-flash-vision-exp
# PI_CUSTOM_PROVIDER_ID=deepseek-vision
# PI_CUSTOM_PROVIDER_API=openai-completions
# PI_CUSTOM_PROVIDER_BASE_URL=https://api.deepseek.com
# PI_CUSTOM_PROVIDER_MODELS=deepseek-v4-flash-vision-exp
# PI_CUSTOM_PROVIDER_API_KEY_ENV=DEEPSEEK_API_KEY

# ===== Image search providers =====
# Comma-separated list of enabled providers. Query runs on all of them in parallel.
PROVIDERS=ddg,bing,wikimedia
# Optional API keys / tokens (enable the corresponding provider by adding it to PROVIDERS):
# OPENVERSE_TOKEN=
# SERPER_API_KEY=

# ===== Behaviour =====
SAFE_SEARCH=true
# HTTP(S) proxy for image-source fetching (some sources are blocked / flaky
# from mainland China; bing is usually reachable directly).
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1
# Who runs the vision filter: auto (filter when a vision model is configured) |
# server (always filter, for text-only calling models) | client (never filter,
# the multimodal calling model looks at the grid itself).
# FILTER_MODE=auto
# Grid: columns x rows = max candidates per round
GRID_COLUMNS=6
GRID_ROWS=8
GRID_CELL_SIZE=256
# Session time-to-live in minutes (auto cleanup of temp data)
SESSION_TTL_MINUTES=120
# Directories (defaults: system temp for data, ./out for collected images)
# DATA_DIR=
# OUT_DIR=
# HTTP timeouts (ms)
HTTP_TIMEOUT_MS=15000
