{
  "name": "reference-search-mcp",
  "version": "0.1.0",
  "description": "MCP server: natural-language image search with multi-provider fan-out, numbered composite grids, vision-based filtering, and iterative sessions",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "reference-search-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsx scripts/smoke.ts",
    "handshake": "tsx scripts/handshake.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.3",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^17.2.0",
    "sharp": "^0.34.0",
    "typebox": "^1.3.7",
    "undici": "^8.10.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
